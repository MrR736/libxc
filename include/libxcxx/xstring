std::string from_wstring(const wchar_t* s) {
	char* p = xwcstombs(s);
	if (!p) return std::string();
	std::string result(p);
	xfree(p);
	return result;
}

std::string from_wstring(const std::wstring& s) {
	return from_wstring(s.c_str());
}

std::wstring from_string(const char* s) {
	wchar_t* p = xmbstowcs(s);
	if (!p) return std::wstring();
	std::wstring result(p);
	xfree(p);
	return result;
}

std::wstring from_string(const std::string& s) {
	return from_string(s.c_str());
}

class xstring : public std::string {
private:
	mutable wchar_t* _wdata;
	mutable char* _upper;
	mutable char* _lower;
	mutable std::string _uppersource;
	mutable std::string _lowersource;

	void update_wdata(std::size_t* len) const LIBXC_NOEXCEPT {
		if (!xwcsstrcmp(_wdata, c_str())) {
			if (_wdata) xfree(_wdata);
			_wdata = xmbstowcs_len(c_str(),len);
		}
	}

	void update_wdata() const LIBXC_NOEXCEPT {
		if (!xwcsstrcmp(_wdata, c_str())) {
			if (_wdata) xfree(_wdata);
			_wdata = xmbstowcs(c_str());
		}
	}

	void update_upper() const LIBXC_NOEXCEPT {
		if (_upper == nullptr || _uppersource != c_str()) {
			char* result = xtoupper(c_str());
			if (_upper) xfree(_upper);
			_upper = result;
			_uppersource = c_str();
		}
	}

	void update_upper(xlocale_t l) const LIBXC_NOEXCEPT {
		if (_upper == nullptr || _uppersource != c_str()) {
			char* result = xtoupper_l(c_str(),l);
			if (_upper) xfree(_upper);
			_upper = result;
			_uppersource = c_str();
		}
	}

	void update_lower() const LIBXC_NOEXCEPT {
		if (_lower == nullptr || _lowersource != c_str()) {
			char* result = xtolower(c_str());
			if (_lower) xfree(_lower);
			_lower = result;
			_lowersource = c_str();
		}
	}

	void update_lower(xlocale_t l) const LIBXC_NOEXCEPT {
		if (_lower == nullptr || _lowersource != c_str()) {
			char* result = xtolower_l(c_str(),l);
			if (_lower) xfree(_lower);
			_lower = result;
			_lowersource = c_str();
		}
	}

public:
	xstring() : std::string(), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}

	xstring(const char* s) : std::string(s), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const char* s,std::size_t len) : std::string(s,len), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const std::string& s) : std::string(s), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const std::string& s,std::size_t len) : std::string(s,len), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}

	xstring(const wchar_t* s) : std::string(from_wstring(s)), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const wchar_t* s,std::size_t len) : std::string(from_wstring(s),len), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const std::wstring& s) : std::string(from_wstring(s)), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const std::wstring& s,std::size_t len) : std::string(from_wstring(s),len), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}

#if CPLUSPLUS_GE(STDC17PP)
	xstring(const std::string_view& s) : std::string(s.data()), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
	xstring(const std::wstring_view& s) : std::string(from_wstring(s.data())), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {}
#endif

	xstring(const xstring& other) : std::string(other), _wdata(nullptr), _upper(nullptr), _lower(nullptr) {
		if (other._wdata) _wdata = xmbstowcs(other.c_str());
		if (other._upper) _upper = xtoupper(other.c_str());
		if (other._lower) _lower = xtolower(other.c_str());
	}

	xstring(xstring&& other) LIBXC_NOEXCEPT : std::string(std::move(other)), _wdata(other._wdata), _upper(other._upper), _lower(other._lower) {
		other._wdata = nullptr;
		other._upper = nullptr;
		other._lower = nullptr;
	}

	xstring& operator=(const xstring& other) {
		if (this != &other) {
			std::string::operator=(other);
			if (_wdata) xfree(_wdata);
			_wdata = nullptr;
			if (other._wdata) _wdata = xmbstowcs(other.c_str());

			if (_upper) xfree(_upper);
			_upper = nullptr;
			if (other._upper) _upper = xtoupper(other.c_str());

			if (_lower) xfree(_lower);
			_lower = nullptr;
			if (other._lower) _lower = xtolower(other.c_str());
		}

		return *this;
	}

	xstring& operator=(xstring&& other) LIBXC_NOEXCEPT {
		if (this != &other) {
			std::string::operator=(std::move(other));
			if (_wdata) xfree(_wdata);
			_wdata = other._wdata;
			other._wdata = nullptr;

			if (_upper) xfree(_upper);
			_upper = other._upper;
			other._upper = nullptr;

			if (_lower) xfree(_lower);
			_lower = other._lower;
			other._lower = nullptr;
		}

		return *this;
	}

	~xstring() LIBXC_NOEXCEPT {
		if (_wdata) xfree(_wdata);
		if (_upper) xfree(_upper);
		if (_lower ) xfree(_lower);
	}

	wchar_t* wdata() LIBXC_NOEXCEPT {
		update_wdata();
		return _wdata;
	}

	wchar_t* wdata(std::size_t* len) LIBXC_NOEXCEPT {
		update_wdata(len);
		return _wdata;
	}

	const wchar_t* c_wstr() const LIBXC_NOEXCEPT {
		update_wdata();
		return _wdata;
	}

	const wchar_t* c_wstr(std::size_t* len) const LIBXC_NOEXCEPT {
		update_wdata(len);
		return _wdata;
	}

	char* cdata() LIBXC_NOEXCEPT {
#if CPLUSPLUS_GE(STDC17PP)
		return data();
#else
		return empty() ? nullptr : &(*this)[0];
#endif
	}

	const char* c_cstr() const LIBXC_NOEXCEPT {
		return c_str();
	}

	const char* tolower() const LIBXC_NOEXCEPT {
		update_lower();
		return _lower;
	}

	const char* tolower(xlocale_t l) const LIBXC_NOEXCEPT {
		update_lower(l);
		return _lower;
	}

	const char* toupper() const LIBXC_NOEXCEPT {
		update_upper();
		return _upper;
	}

	const char* toupper(xlocale_t l) const LIBXC_NOEXCEPT {
		update_upper(l);
		return _upper;
	}

	int compares(const char *const *s, size_t n) const LIBXC_NOEXCEPT {
		if (!s) return 1;
		for (size_t i = 0; i < n; ++i) {
			if (empty() && !s[i]) return 0;
			if (s[i] && strcmp(c_str(), s[i]) == 0) return 0;
		}
		return 1;
	}

	int compares(const std::vector<const char*>& ss) const LIBXC_NOEXCEPT {
		return compares(ss.data(),ss.size());
	}

	int compares(const std::list<const char*>& ss) const LIBXC_NOEXCEPT {
		for (const char* s : ss) {
			if (empty() && !s) return 0;
			if (s && strcmp(c_str(), s) == 0) return 0;
		}
		return 1;
	}

#if CPLUSPLUS_GE(STDC17PP)
	std::string_view view() const noexcept {
		return std::string_view(data(), size());
	}

	std::string_view cview() const noexcept {
		return view();
	}

	std::wstring_view wview() const noexcept {
		return std::wstring_view(c_wstr(), size());
	}
#endif
};

