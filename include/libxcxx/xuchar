#define XSTD_USTR_DISPATCH(T, name, ...) \
	if constexpr (__libxc_types_compatible_p(T,char8_t)) { \
		return ustr8##name(__VA_ARGS__); \
	} else if constexpr (__libxc_types_compatible_p(T,wchar_t)) { \
		return wcs##name(__VA_ARGS__); \
	} else if constexpr (__libxc_types_compatible_p(T,char16_t)) { \
		return ustr16##name(__VA_ARGS__); \
	} else if constexpr (__libxc_types_compatible_p(T,char32_t)) { \
		return ustr32##name(__VA_ARGS__); \
	} else { \
		LIBXC_STATIC_ASSERT(__libxc_types_compatible_p(T,void),"Unsupported character type"); \
	}


template<typename CharT>
inline std::size_t XCALLAPI ustrlen(const CharT* xrestrict s) {
	XSTD_USTR_DISPATCH(CharT, len, s)
	return 0;
}

template<typename CharT>
inline std::size_t XCALLAPI ustrlen(const CharT* xrestrict s, std::size_t maxlen) {
	XSTD_USTR_DISPATCH(CharT, nlen, s, maxlen)
	return 0;
}

