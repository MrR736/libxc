template<typename CharT>
inline char* XCALLAPI xmbrtoc_len(const CharT* xrestrict pc8,size_t* out_size) {
	if constexpr (std::is_same_v<CharT,char8_t>) {
		return xmbrtoc8_len(pc8,out_size);
	} else if constexpr (std::is_same_v<CharT,char16_t>) {
		return xmbrtoc16_len(pc8,out_size);
	} else if constexpr (std::is_same_v<CharT,char32_t>) {
		return xmbrtoc32_len(pc8,out_size);
	} else {
		LIBXC_STATIC_ASSERT(std::is_same_v<CharT,void>,"Unsupported character type");
		return nullptr;
	}
}

template<typename CharT>
inline char* XCALLAPI xmbrtoc(const CharT* xrestrict pc8) {
	return xmbrtoc_len(pc8,nullptr);
}

template<typename CharT>
inline CharT* XCALLAPI xcrtomb_len(const char* xrestrict pc8,size_t* out_size) {
	if constexpr (std::is_same_v<CharT,char8_t>) {
		return xc8rtomb_len(pc8,out_size);
	} else if constexpr (std::is_same_v<CharT,char16_t>) {
		return xc16rtomb_len(pc8,out_size);
	} else if constexpr (std::is_same_v<CharT,char32_t>) {
		return xc32rtomb_len(pc8,out_size);
	} else {
		LIBXC_STATIC_ASSERT(std::is_same_v<CharT,void>,"Unsupported character type");
		return nullptr;
	}
}

template<typename CharT>
inline CharT* XCALLAPI xcrtomb(const char* xrestrict pc8) {
	return xcrtomb_len<CharT>(pc8,nullptr);
}

