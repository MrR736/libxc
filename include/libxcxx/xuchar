#ifndef __XUCHAR__
#define __XUCHAR__

#include "xuchar.h"

namespace xstd __xvisibility__(default) {

#define XSTD_USTR_DISPATCH(CharT, name, ...) \
	if constexpr (std::is_same_v<CharT, char8_t>) { \
		return ustr8##name(__VA_ARGS__); \
	} else if constexpr (std::is_same_v<CharT, char16_t>) { \
		return ustr16##name(__VA_ARGS__); \
	} else if constexpr (std::is_same_v<CharT, char32_t>) { \
		return ustr32##name(__VA_ARGS__); \
	} else { \
		LIBXC_STATIC_ASSERT(std::is_same_v<CharT, void>,"Unsupported character type"); \
	}


template<typename CharT>
inline std::size_t XCALLAPI ustrlen(const CharT* xrestrict s) {
	XSTD_USTR_DISPATCH(CharT, len, s)
	return 0;
}

template<typename CharT>
inline std::size_t XCALLAPI ustrlen(const CharT* xrestrict s, std::size_t maxlen) {
	XSTD_USTR_DISPATCH(CharT, nlen, s, maxlen)
	return 0;
}

