template<typename CharT>
inline const CharT* XCALLAPI ustrbasename(const CharT* xrestrict src) {
	if constexpr (__libxc_types_compatible_p(CharT,char8_t)) {
		return ustr8basename(src);
	} else if constexpr (__libxc_types_compatible_p(CharT,wchar_t)) {
		return xwbasename(src);
	} else if constexpr (__libxc_types_compatible_p(CharT,char16_t)) {
		return ustr16basename(src);
	} else if constexpr (__libxc_types_compatible_p(CharT,char32_t)) {
		return ustr32basename(src);
	} else {
		LIBXC_STATIC_ASSERT(__libxc_types_compatible_p(CharT,void), "Unsupported character type");
	}
	return nullptr;
}

template<typename CharT>
inline CharT* XCALLAPI ustrcmbs(const CharT* const* xrestrict src, std::size_t n) {
	if constexpr (__libxc_types_compatible_p(CharT,char8_t)) {
		return ustr8cmbs(src, n);
	} else if constexpr (__libxc_types_compatible_p(CharT,wchar_t)) {
		return xwcscmbs(src, n);
	} else if constexpr (__libxc_types_compatible_p(CharT,char16_t)) {
		return ustr16cmbs(src, n);
	} else if constexpr (__libxc_types_compatible_p(CharT,char32_t)) {
		return ustr32cmbs(src, n);
	} else {
		LIBXC_STATIC_ASSERT(__libxc_types_compatible_p(CharT,void), "Unsupported character type");
	}
	return nullptr;
}

template<typename CharT>
inline CharT* XCALLAPI ustrcmbs(const std::vector<CharT*>& s) {
	return ustrcmbs<CharT>(s.data(),s.size());
}

template<typename CharT>
inline CharT* XCALLAPI ustrcmps(const CharT* xrestrict s1,const CharT* const* xrestrict s2, std::size_t n) {
	if constexpr (__libxc_types_compatible_p(CharT,char8_t)) {
		return ustr8cmps(s1, s2, n);
	} else if constexpr (__libxc_types_compatible_p(CharT,wchar_t)) {
		return xwcscmp(s1, s2, n);
	} else if constexpr (__libxc_types_compatible_p(CharT,char16_t)) {
		return ustr16cmps(s1, s2, n);
	} else if constexpr (__libxc_types_compatible_p(CharT,char32_t)) {
		return ustr32cmps(s1, s2, n);
	} else {
		LIBXC_STATIC_ASSERT(__libxc_types_compatible_p(CharT,void), "Unsupported character type");
