#ifndef __XSSTREAM__
#define __XSSTREAM__


#include <sstream>
#include <string>
#include <utility>

#include "xstring"

namespace xstd __xvisibility__(default) {

class ixstringstream : public std::istringstream {
public:
	ixstringstream() = default;

	ixstringstream(const xstring& s): std::istringstream(s) {}
	ixstringstream(xstring&& s) : std::istringstream(s) {}
	ixstringstream(const std::string& s) : std::istringstream(s) {}
	ixstringstream(std::string&& s) : std::istringstream(std::move(s)) {}
	ixstringstream(const char* s) : std::istringstream(s ? s : "") { }

	xstring xstr() const {
		return str();
	}

	void xstr(const xstring& s) {
		std::istringstream::str(static_cast<const std::string&>(s));
	}

#if CPLUSPLUS_GE(STDC20PP)
	void xstr(xstring&& s) {
		std::istringstream::str(static_cast<std::string&&>(s));
	}

	template<class Allocator>
	std::basic_string<char, std::char_traits<char>, Allocator>
	xstr(const Allocator& alloc) const {
		return std::istringstream::str(alloc);
	}
#endif

	xwstring xwstr() const {
		return xwstring(std::istringstream::str());
	}

	void xwstr(const xwstring& s) {
		std::istringstream::str(static_cast<const std::string&>(s.c_cstr()));
	}

#if CPLUSPLUS_GE(STDC20PP)
	void xwstr(xstring&& s) {
		std::istringstream::str(static_cast<std::string&&>(s));
	}

	template<class Allocator>
	std::basic_string<wchar_t, std::char_traits<wchar_t>, Allocator>
	xwstr(const Allocator& alloc) const {
		return std::istringstream::str(alloc);
	}
#endif
};

}

#endif